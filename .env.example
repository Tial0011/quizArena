# Set these in Netlify (Site configuration > Environment variables). Do not commit real values.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...
# One-line JSON for a Firebase service account with Firebase Auth, Firestore, and FCM access.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"quizarena-2c75e","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@quizarena-2c75e.iam.gserviceaccount.com","client_id":"..."}
# Optional, only if using ?firebaseEnv=staging. Use the quiz-arena-staging service account.
FIREBASE_SERVICE_ACCOUNT_JSON_STAGING={"type":"service_account","project_id":"quiz-arena-staging","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@quiz-arena-staging.iam.gserviceaccount.com","client_id":"..."}
# Optional staging-only checkout key. Use a Flutterwave test key, never the production key.
FLUTTERWAVE_SECRET_KEY_STAGING=FLWSECK_TEST-...
