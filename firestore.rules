rules_version = '2';

// Quiz Arena — balanced rules: strict where money/roles are involved,
// relaxed where the app needs students to see each other (leaderboards, groups).
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && request.auth.token.email == "admin@test.com";
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------- users ----------
    // Signed-in users can read profiles (group leaderboards need names/streaks).
    match /users/{uid} {
      allow read: if signedIn();

      // New accounts must start as an empty-handed student.
      allow create: if isSelf(uid)
                    && request.resource.data.role == "student"
                    && request.resource.data.purchasedQuizzes == [];

      // Students edit their own doc (streak, name, activity, push tokens...)
      // but can never change their role or grant themselves quizzes.
      allow update: if isAdmin()
                    || (isSelf(uid)
                        && !request.resource.data.diff(resource.data)
                             .affectedKeys().hasAny(["role", "purchasedQuizzes"]));

      allow delete: if isAdmin();
    }

    // ---------- content (admin writes, signed-in reads) ----------
    match /subjects/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /quizzes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- purchases ----------
    // Created only by the Cloud Function after Flutterwave confirms payment
    // (the Admin SDK bypasses these rules). Clients can't mint "paid" purchases.
    match /purchases/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // Admin dashboard revenue totals use server-side aggregation queries.
    // Payment records remain unreadable to students and client writes stay blocked.
    match /flutterwaveTransactions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- attempts ----------
    match /attempts/{id} {
      // Attempt histories are private. Group leaderboards use compact summaries.
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Weekly scores and leaderboard snapshots are backend-only. The callable
    // returns only the top 15 and the signed-in user's group ranks.
    match /weeklyChallengeScores/{scoreId} {
      allow read: if false;
      allow write: if false;
    }

    match /weeklyChallengeProjection/{weekKey} {
      allow read: if false;
      allow write: if false;
    }

    match /weeklyChallengeLeaderboardSnapshots/{weekKey} {
      allow read, write: if false;
    }

    // Admin reviews weekly winners and records manual payout completion.
    // Winner records are created by Cloud Functions through the Admin SDK.
    match /weeklyWinners/{weekKey} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // ---------- notifications ----------
    match /notifications/{id} {
      allow read: if signedIn();
      // Admin broadcasts, or the app's own welcome message to the new user.
      allow create: if isAdmin()
                    || (signedIn() && request.resource.data.targetUserId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------- friend groups ----------
    match /friendGroups/{id} {
      allow read: if signedIn();   // joining by code needs to look a group up
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() >= 1
                    && request.resource.data.memberIds.size() <= 5
                    && request.auth.uid in request.resource.data.memberIds;
      // Only the owner can approve members or remove them. Keep the group
      // owner in the list and enforce the five-member limit in the database.
      allow update: if signedIn()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberIds"])
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() >= 1
                    && request.resource.data.memberIds.size() <= 5
                    && request.auth.uid in request.resource.data.memberIds
                    && (
                      (request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
                       && request.resource.data.memberIds.hasAll(resource.data.memberIds))
                      || (resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
                          && resource.data.memberIds.hasAll(request.resource.data.memberIds))
                    );
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /groupJoinRequests/{id} {
      // Only the requester and the target group's owner can see a request.
      allow read: if isAdmin()
                  || (signedIn() && (
                       resource.data.requesterId == request.auth.uid
                       || get(/databases/$(database)/documents/friendGroups/$(resource.data.groupId))
                            .data.ownerId == request.auth.uid
                     ));
      allow create: if signedIn()
                    && request.resource.data.requesterId == request.auth.uid
                    && request.resource.data.status == "pending"
                    && exists(/databases/$(database)/documents/friendGroups/$(request.resource.data.groupId))
                    && get(/databases/$(database)/documents/friendGroups/$(request.resource.data.groupId))
                         .data.memberIds.size() < 5
                    && !(request.auth.uid in get(/databases/$(database)/documents/friendGroups/$(request.resource.data.groupId))
                         .data.memberIds);
      // Only a group owner can change a pending request's decision.
      allow update: if isAdmin() || (signedIn()
                    && resource.data.status == "pending"
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
                    && request.resource.data.status in ["accepted", "rejected"]
                    && get(/databases/$(database)/documents/friendGroups/$(resource.data.groupId))
                         .data.ownerId == request.auth.uid);
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.requesterId == request.auth.uid)
                    || (signedIn()
                        && get(/databases/$(database)/documents/friendGroups/$(resource.data.groupId))
                             .data.ownerId == request.auth.uid);
    }

    // ---------- login tracking (admin dashboard) ----------
    match /loginEvents/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Everything else is Cloud-Function-only.
  }
}
